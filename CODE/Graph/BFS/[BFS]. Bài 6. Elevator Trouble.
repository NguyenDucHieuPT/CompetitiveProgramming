const int INF = 1e9 + 1;
const ll INFF = 1e18 + 1;
const int MaxN = 1e6 + 1;
const int MOD = 1e9 + 7;

namespace solve 
{
    const int MN = 1e6 + 1;
    int nb[MN] = {},
        dx[2];
    bool visited[MN];
    int f, s, g, u, d;

    int BFS()
    {
        queue <int> q;
        visited[u] = 1;
        q.push(s);
        while(!q.empty())
        {
            int x = q.front();
            q.pop();
            if (x == g)
                return nb[x];
            for(int k = 0; k <= 1; k++)
            {
                int y = x + dx[k];
                if (y < 1 || y > f)continue;

                if (!visited[y])
                {
                    q.push(y);
                    nb[y] = nb[x] + 1;
                    visited[y] = 1;
                }
            }
        }
        return -1;
    }

    void process(void)
    {
        cin >> f >> s >> g >> u >> d;
        dx[0] = -d;
        dx[1] = +u;
        int ans = BFS();
        if (ans != -1)
            cout << ans;
        else
            cout << "use the stairs";
    }
}

