namespace solve 
{
    const int MN = 101;
    char a[MN][MN];
    int dx[] = {-1, -1, -1, 0, 0, 1, 1, 1},
        dy[] = {-1, 0, 1, -1, 1, -1, 0, 1};

    void BFS(int u, int v)
    {
        queue<pii> q;
        q.push({u, v});
        a[u][v] = '.'; 
        while(!q.empty())
        {
            int x = q.front().first,
                y = q.front().second;
            q.pop();
            for(int k = 0; k < 8; k++)
            {
                int xx = x + dx[k],
                    yy = y + dy[k];
                if (a[xx][yy] == 'W')
                {
                    a[xx][yy] = '.'; 
                    q.push({xx, yy});
                }
            }
        }
    }
    void process(void)
    {
        memset(a, '.', sizeof(a));
        int n, m;
        cin >> n >> m;
        for(int i = 1; i <= n; i++)
        {
            for(int j = 1; j <= m; j++)
            {
                cin >> a[i][j];
            }
        }

        int result = 0;
        for(int i = 1; i <= n; i++)
            for(int j = 1; j <= m; j++)
                if (a[i][j] == 'W')
                {
                    BFS(i, j);
                    result++;
                }
        cout << result;
    }
}

