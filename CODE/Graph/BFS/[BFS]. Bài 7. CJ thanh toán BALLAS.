const int MOD = 1e9 + 7;

namespace solve 
{
    const int MN = 1e6 + 1;

    vector<int> adj[MN];
    int d[MN] = {};
    bool visited[MN];

    void BFS(int u, int v)
    {
        queue <int> q;
        visited[u] = 1;
        q.push(u);
        while(!q.empty())
        {
            int x = q.front();
            q.pop();
            if (x == v)
                return;
            for(vector<int>::iterator y = adj[x].begin(); y != adj[x].end(); y++)
            {
                if (!visited[*y])
                {
                    q.push(*y);
                    d[*y] = x;
                    visited[*y] = 1;
                }
            }
        }
    }

    void process(void)
    {
        int n, m, s, t;
        cin >> n >> m >> s >> t;
        while(m--)
        {
            int x, y;
            cin >> x >> y;
            adj[x].push_back(y);
        }
        for(int i = 1; i <= n; i++)
        {
            sort(adj[i].begin(), adj[i].end());
        }
        BFS(s, t);
        vector<int> road;
        while(t != s)
        {
            road.push_back(t);
            t = d[t];
        }
        road.push_back(s);
        reverse(road.begin(), road.end());
        for(vector<int>::iterator x = road.begin(); x != road.end(); x++)
            cout << *x << " ";
    }
}

