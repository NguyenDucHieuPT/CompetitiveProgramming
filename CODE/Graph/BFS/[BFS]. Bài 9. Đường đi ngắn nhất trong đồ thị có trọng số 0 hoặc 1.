const int INF = 1e9 + 1;
const ll INFF = 1e18 + 1;
const int MaxN = 1e6 + 1;
const int MOD = 1e9 + 7;

namespace solve
{
    const int MN = 1e6 + 1;
    int n, m, d[MN];
    vector<pair<int, int>> adj[MN];

    void bfs(int s)
    {
        memset(d, INF, sizeof(d));
        deque<int> q;
        q.push_front(s);
        d[s] = 0;

        while(!q.empty())
        {
            int u = q.front();
            q.pop_front();

            if (u == n) return;

            for(vector<pair<int, int>>::iterator edge = adj[u].begin(); edge != adj[u].end(); edge++)
            {
                int v = (*edge).second,
                    w = (*edge).first;

                if (d[v] > d[u] + w)
                {
                    d[v] = d[u] + w;

                    if (w)
                    {
                        q.push_back(v);
                    }
                    else
                    {
                        q.push_back(v);
                    }
                }
            }
        }
    }
    void process(void)
    {
        cin >> n >> m;
        while(m--)
        {
            int u, v;
            cin >> u >> v;
            adj[u].push_back({0, v});
            adj[v].push_back({1, u});
        }
        bfs(1);
        cout << d[n];
    }
}


