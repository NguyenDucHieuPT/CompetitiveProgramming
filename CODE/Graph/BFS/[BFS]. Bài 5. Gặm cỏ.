namespace solve 
{
    const int MN = 201;
    char a[MN][MN];
    int dx[] = {-1, 0, 0, 1},
        dy[] = {0, 1, -1, 0},
        d[MN][MN];

    int BFS(pair<int, int> b, pair<int, int> c)
    {
        queue<pii> q;
        int u = b.first, v = b.second;
        q.push({u, v});
        a[u][v] = '*'; 
        while(!q.empty())
        {
            int x = q.front().first,
                y = q.front().second;
            q.pop();
            //cout << x << " " << y << endl;
            for(int k = 0; k < 4; k++)
            {
                int xx = x + dx[k],
                    yy = y + dy[k];
                if (c.first == xx && c.second == yy)
                {
                    return d[x][y] + 1;
                }
                if (a[xx][yy] == '.')
                {
                    d[xx][yy] = d[x][y] + 1;
                    a[xx][yy] = '*'; 
                    q.push({xx, yy});
                }
            }
        }
        return 1;
    }
    void process(void)
    {
        memset(a, 0, sizeof(a));
        int n, m;
        pair<int, int> b, c;
        cin >> n >> m;
        for(int i = 1; i <= n; i++)
            for(int j = 1; j <= m; j++)
            {
                cin >> a[i][j];
                if (a[i][j] == 'B')
                    b = {i, j};
                if (a[i][j] == 'C')
                    c = {i, j};
            }
        cout << BFS(b, c);
    }
}

