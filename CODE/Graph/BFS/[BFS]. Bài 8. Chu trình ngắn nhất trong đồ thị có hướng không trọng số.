namespace solve 
{
    const int MN = 1e6 + 1;

    vector<int> adj[MN];
    int d[MN] = {};
    bool visited[MN];

    bool BFS(int u)
    {
        memset(d, 0, sizeof(d));
        memset(visited, 0, sizeof(visited));
        queue <int> q;
        q.push(u);
        bool ok = false;
        while(!q.empty())
        {
            int x = q.front();
            q.pop();
            if (x == u && ok)
                return true;
            for(vector<int>::iterator y = adj[x].begin(); y != adj[x].end(); y++)
            {
                if (!visited[*y])
                {
                    q.push(*y);
                    d[*y] = d[x] + 1;
                    visited[*y] = 1;
                }
            }
            ok = true;
        }
        return false;
    }

    void process(void)
    {
        int n;
        cin >> n;
        for(int i = 1; i <= n; i++)
        {
            for(int j = 1; j <= n; j++)
            {
                int Hij;
                cin >> Hij;
                if (Hij) adj[i].push_back(j);
            }
        }
        for(int i = 1; i <= n; i++)
        {
            if (BFS(i))
            {
                cout << d[i] << endl;
            }
            else
            {
                cout << "NO WAY" << endl;
            }
        }

    }
}

