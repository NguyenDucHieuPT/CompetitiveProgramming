const int MaxN = 1e6 + 1;
const int MOD = 1e9 + 7;

namespace solve 
{
    const int MaxMN = 1e5 + 1;
    int result = 0;
    vector<int> adj[MaxMN];
    int visited[MaxMN] = {};
    void BFS(int s)
    {
        result++;
        queue <int> q;
        q.push(s);
        visited[s] = true;
        while (!q.empty())
        {
            int u = q.front();
            q.pop();
            for(vector<int>::iterator v = adj[u].begin(); v!=adj[u].end(); v++)
                if (!visited[*v])
                {
                    visited[*v] = true;
                    q.push(*v);
                }
        }
    }
    void process() 
    {
        int n, m;
        cin >> n >> m;
        while(m--)
        {
            int x, y;
            cin >> x >> y;
            adj[x].push_back(y);
            adj[y].push_back(x);
        }
        for(int i = 1; i <= n; i++)
            if (!visited[i])
                BFS(i);
        cout << result;
    }
}

