namespace solve 
{
    vector<int> adj[255];
    int visited[255] = {};

    void BFS(int s)
    {
        queue <int> q;
        q.push(s);
        visited[s] = true;
        while(!q.empty())
        {
            int u = q.front();
            q.pop();
            for(vector<int>::iterator v = adj[u].begin(); v != adj[u].end(); v++)
                if(!visited[*v])
                {
                    q.push(*v);
                    visited[*v] = true;
                }
        }
    }
    void process(void)
    {
        int n, m;
        cin >> n >> m;
        while(m--)
        {
            int x, y;
            cin >> x >> y;
            adj[x].push_back(y);
            adj[y].push_back(x);
        }
        BFS(1);
        bool ok = 1;
        for(int i = 1; i <= n; i++)
            if (!visited[i])
            {
                cout << i << endl;
                ok = 0;
            }
        if (ok) cout << 0;
    }
}

