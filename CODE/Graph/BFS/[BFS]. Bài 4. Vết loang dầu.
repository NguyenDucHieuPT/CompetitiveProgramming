namespace solve 
{
    const int MN = 256;
    int a[MN][MN];
    int dx[] = {-1, 0, 0, 1},
        dy[] = {0, 1, -1, 0};

    int BFS(int u, int v)
    {
        queue<pii> q;
        q.push({u, v});
        a[u][v] = '.'; 
        int result = 1;
        while(!q.empty())
        {
            int x = q.front().first,
                y = q.front().second;
            q.pop();
            for(int k = 0; k < 4; k++)
            {
                int xx = x + dx[k],
                    yy = y + dy[k];
                if (a[xx][yy] == 1)
                {
                    result++;
                    a[xx][yy] = 0; 
                    q.push({xx, yy});
                }
            }
        }
        return result;
    }
    void process(void)
    {
        memset(a, 0, sizeof(a));
        int n, m;
        
        while(cin >> n >> m)
        { 
            if (!n && !m)
                return;
            for(int i = 1; i <= n; i++)
            {
                for(int j = 1; j <= m; j++)
                {
                    cin >> a[i][j];
                }
            }
            map<int, int> slicks;
            int slicks_size = 0;
            for(int i = 1; i <= n; i++)
                for(int j = 1; j <= m; j++)
                    if (a[i][j] == 1)
                    {
                        slicks_size ++;
                        slicks[BFS(i, j)]++;
                    }
            cout << slicks_size << endl;
            for(map<int, int>::iterator x = slicks.begin(); x != slicks.end(); x++)
                cout << (*x).first << " " << (*x).second << endl;
        }
    }
}

