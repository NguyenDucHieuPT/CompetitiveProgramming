namespace solve
{
    int a[MaxN], f[MaxN], n, q;
    void prefix_sum()
    {
        f[0] = 0;
        FE(i, 1, n)
            f[i] = f[i - 1] + a[i];
    }
    void query()
    {
        int l, r;
        cin >> l >> r;
        cout << f[r + 1] - f[l] << endl;
    }
    void process(void)
    {
        cin >> n >> q;
        FE(i, 1, n)
            cin >> a[i];
        prefix_sum();
        while(q--)
            query();
    }
}


