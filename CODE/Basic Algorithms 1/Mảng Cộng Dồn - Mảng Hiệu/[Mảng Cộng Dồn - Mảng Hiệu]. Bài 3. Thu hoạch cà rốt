namespace solve 
{
    vector<vector<int>> a, f;
    int n, m, q;

    void prefix_sum()
    {
        FE(i, 1, n) 
            FE(j, 1, m) 
                f[i][j] = f[i - 1][j] + f[i][j - 1] - f[i - 1][j - 1] + a[i - 1][j - 1];
    }

    void query() 
    {
        int x1, y1, x2, y2;
        cin >> x1 >> x2 >> y1 >> y2;
        cout <<  f[x2][y2] - f[x1 - 1][y2] - f[x2][y1 - 1] + f[x1 - 1][y1 - 1] << endl;
    }

    void process() 
    {
        cin >> n >> m;
        a.assign(n, vector<int>(m));
        f.assign(n + 1, vector<int>(m + 1, 0));

        FL(i, 0, n)
            FL(j, 0, m)
                cin >> a[i][j];

        prefix_sum();
        cin >> q;
        while (q--)
            query();
    }
}

