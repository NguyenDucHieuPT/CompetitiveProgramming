namespace solve 
{
    vector<int> a, d, MarkedArray;
    int n, m, q;

    void query() 
    {
        int l, r, k;
        cin >> l >> r >> k;
        MarkedArray[l] += k;
        MarkedArray[r + 1] -= k;
    }
    void prefix_sum()
    {
        d.resize(n);
        d[0] = MarkedArray[0];
        FL(i, 1, n)
            d[i] = d[i - 1] + MarkedArray[i];
    }
    void process() 
    {
        cin >> n >> q;
        a.resize(n);
        d.resize(n);
        FL(i, 0, n)
            cin >> a[i];
        MarkedArray.assign(n + 1, 0);
        while(q--)
            query();
        prefix_sum();
        FL(i, 0, n)
        {
            a[i] = a[i] + d[i];
            cout << a[i] << " ";
        }

    }
}

