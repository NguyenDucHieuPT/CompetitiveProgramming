const ll INFF = 1e18 + 1;
const int MaxN = 1e6 + 1;
const int MOD = 1e9 + 7;

namespace solve 
{
    vector<int> a, f, MarkedArray;
    int n, m, q;

    void query() 
    {
        int l, r;
        cin >> l >> r ;
        MarkedArray[l - 1] += 1;
        if (r < n)
            MarkedArray[r] -= 1;
    }
    void prefix_sum()
    {
        f.resize(n);
        f[0] = MarkedArray[0];
        FL(i, 1, n)
            f[i] = f[i - 1] + MarkedArray[i];
    }
    void process() 
    {
        cin >> n >> q;
        a.resize(n);
        f.resize(n);
        FL(i, 0, n)
            cin >> a[i];
        MarkedArray.assign(n, 0);
        while(q--)
            query();
        prefix_sum();
        sort(a.begin(), a.end(), greater<int>());
        sort(f.begin(), f.end(), greater<int>());
        ll res = 0;
        FL(i, 0, n)
            res += (ll) a[i] * f[i];
        cout << res;
    }
}

